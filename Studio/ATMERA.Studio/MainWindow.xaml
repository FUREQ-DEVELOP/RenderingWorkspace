<Window x:Class="ATMERA.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ATMERA Studio" Width="960" Height="640" MinWidth="640" MinHeight="420"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Background="{StaticResource PanelBrush}" Padding="12">
      <WrapPanel VerticalAlignment="Center">
        <TextBlock Text="ATMERA Studio" FontSize="16" FontWeight="SemiBold"
                   VerticalAlignment="Center" Margin="0,0,16,0"/>
        <ComboBox x:Name="BackendSelector" Width="125" Height="28" DisplayMemberPath="Name"
                  SelectionChanged="OnBackendChanged" AutomationProperties.Name="Rendering backend"/>
        <CheckBox x:Name="ForceWarpCheckBox" Content="Force WARP" Margin="14,0,14,0"
                  VerticalAlignment="Center" Checked="OnForceWarpChanged" Unchecked="OnForceWarpChanged"/>
        <Button Content="Open HLSL" Click="OnOpenShader" Padding="10,0" Height="28" Margin="0,0,8,0"/>
        <Button Content="Reload" Click="OnReloadShader" Padding="10,0" Height="28" Margin="0,0,8,0"/>
        <Button Content="Bundled shader" Click="OnUseBundledShader" Padding="10,0" Height="28"/>
      </WrapPanel>
    </Border>
    <Border Grid.Row="1" Background="{StaticResource PanelBrush}" Margin="0,1,0,0" Padding="12,7">
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
          <Button x:Name="PauseButton" Content="Pause" Click="OnTogglePause"
                  IsEnabled="False" Width="74" Height="27"/>
          <Button x:Name="StepButton" Content="Step frame" Click="OnStepFrame"
                  IsEnabled="False" Height="27" Padding="10,0" Margin="8,0,0,0"/>
        </StackPanel>
        <StackPanel Margin="18,0,0,0">
          <TextBlock x:Name="ShaderLabel" Foreground="#9DA8B4" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="DeviceInfoLabel" Foreground="#9DA8B4" FontSize="11"
                     AutomationProperties.Name="Renderer capabilities"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Border Grid.Row="2" Background="#111519" Margin="12">
      <ContentControl x:Name="ViewportContent"/>
    </Border>
    <Border Grid.Row="3" Background="{StaticResource PanelBrush}" Padding="12,7">
      <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.Name="Studio status"/>
      </ScrollViewer>
    </Border>
  </Grid>
</Window>
